      "eyebrow": "02 // THEORETICAL FORMULATION",
      "title": "核心数学建模：潜空间**耗散端口哈密顿神经微分方程**",
      "subtitle": "在保守辛结构矩阵基础上引入半正定瑞利耗散势，统一刻画弹性碰撞与真实接触摩擦。",
      "formula_block": {
        "title": "Dissipative Port-Hamiltonian Dynamics",
        "equation_number": "(Eq. 3)",
        "latex": "\\frac{d}{dt}\\begin{bmatrix} \\mathbf{q}_t \\\\ \\mathbf{p}_t \\end{bmatrix} = \\left( \\mathbf{J} - \\mathbf{R}(\\mathbf{q}_t) \\right) \\nabla \\mathcal{H}_{\\theta}(\\mathbf{q}_t, \\mathbf{p}_t) + \\mathbf{G}(\\mathbf{q}_t)\\mathbf{u}_t",
        "symbols": [
          {
            "symbol": "\\mathbf{q}_t, \\mathbf{p}_t \\in \\mathbb{R}^d",
            "meaning": "由三维高斯溅射编码器提取的对象中心广义坐标与共轭动量"
          },
          {
            "symbol": "\\mathbf{J} = -\\mathbf{J}^\\top",
            "meaning": "反对称辛结构矩阵，从代数结构上严格保证保守内力不做净功"
          },
          {
            "symbol": "\\mathbf{R}(\\mathbf{q}_t) \\succeq 0",
            "meaning": "半正定瑞利摩擦耗散算子，确保零输入下系统总能量单调不增"
          },
          {
            "symbol": "\\mathbf{u}_t",
            "meaning": "外部智能体施加的连续力矩控制向量"
          }
        ]
      },
      "items": [
        {
          "tag": "THEOREM 1",
          "title": "长时程李雅普诺夫有界性保证",
          "accent": true,
          "formula": "\\frac{d\\mathcal{H}_\\theta}{dt} = -(\\nabla_{\\mathbf{p}}\\mathcal{H}_\\theta)^\\top \\mathbf{R} (\\nabla_{\\mathbf{p}}\\mathcal{H}_\\theta) \\le 0",
          "body": "严格证明了任意步长自回归展开均不会发生潜变量范数爆炸。"
        },
